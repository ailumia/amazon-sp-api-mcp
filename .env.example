# Account array for live calls. accountName is optional for one account and required for multiple.
SP_API_ACCOUNTS='[{"accountName":"primary","sellerId":"...","clientId":"...","clientSecret":"...","refreshToken":"...","region":"na"}]'

# Optional runtime controls
SP_API_MAX_RETRIES=5
SP_API_MAX_RESPONSE_BYTES=1048576
SP_API_MAX_CONCURRENCY=4
SP_API_ARTIFACT_DIR=./artifacts
LOG_LEVEL=info

# Streamable HTTP only. Localhost is the secure default.
HOST=127.0.0.1
PORT=3000
MCP_ALLOWED_HOSTS=
MCP_BEARER_TOKEN=
