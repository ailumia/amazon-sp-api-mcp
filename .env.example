# Required for live SP-API calls. Discovery works without credentials.
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=

# na | eu | fe
SP_API_REGION=na

# Optional runtime controls
SP_API_ENDPOINT=
SP_API_MAX_RETRIES=5
SP_API_MAX_RESPONSE_BYTES=1048576
SP_API_MAX_CONCURRENCY=4
SP_API_ARTIFACT_DIR=./artifacts
LOG_LEVEL=info

# Streamable HTTP only. Localhost is the secure default.
HOST=127.0.0.1
PORT=3000
MCP_ALLOWED_HOSTS=
MCP_BEARER_TOKEN=
