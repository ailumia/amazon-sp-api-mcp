# ACCOUNT_NAME is optional for one account and required for multiple accounts.
SP_API_ACCOUNTS='[{"ACCOUNT_NAME":"primary","SP_API_CLIENT_ID":"...","SP_API_CLIENT_SECRET":"...","SP_API_REFRESH_TOKEN":"...","SP_API_REGION":"na"}]'

# Optional runtime controls
SP_API_MAX_RETRIES=5
SP_API_MAX_RESPONSE_BYTES=1048576
SP_API_MAX_CONCURRENCY=4
SP_API_ARTIFACT_DIR=./artifacts
LOG_LEVEL=info

# Streamable HTTP only. Localhost is the secure default.
HOST=127.0.0.1
PORT=3000
MCP_ALLOWED_HOSTS=
MCP_BEARER_TOKEN=
